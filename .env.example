# ==============================================================================
# Cross-Environment Music Genre Recognition Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Execution Device: 'cuda:0' for GPU acceleration or 'cpu'
DEVICE=cuda:0

# Production Model Artifact Path (Decoupled from training pipeline)
MODEL_PATH=models/checkpoints/music_cotmix_dinov3.pt

# Human-In-The-Loop AI Decision Thresholds
# confidence >= 0.80 -> OK (High certainty, accept automatically)
# 0.60 <= confidence < 0.80 -> UNCERTAIN (Flag for human acoustic inspection)
# confidence < 0.60 -> FALLBACK (Reject or ask for cleaner recording)
CONFIDENCE_THRESHOLD=0.80
UNCERTAIN_THRESHOLD=0.60

# Audio Preprocessing Parameters (Must match training pipeline)
SAMPLE_RATE=16000
N_MELS=128
N_FFT=2048
HOP_LENGTH=512
TIME_FRAMES=256

# Temporary Upload Storage (optional)
UPLOAD_DIR=data/uploads
